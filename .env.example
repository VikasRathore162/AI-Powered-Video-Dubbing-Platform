# Every config key is overridable via env (nested with __). Examples:

# CONFIG_FILE=config.yaml
# LIMITS__MAX_DURATION_SEC=600
# LIMITS__MAX_UPLOAD_MB=500
# LIMITS__MAX_CONCURRENT_JOBS=2
# PROCESSING__TASK_MAX_RETRIES=3
# PROVIDERS__STT__NAME=faster_whisper
# PROVIDERS__STT__OPTIONS={"model": "base", "compute_type": "int8"}
# PROVIDERS__TRANSLATION__NAME=argos
# PROVIDERS__TTS__NAME=edge
# SECURITY__API_KEY=change-me           # bearer token clients must send
# SECURITY__RATE_LIMIT=10/minute
# DB_URL=postgresql+psycopg2://dub:dub@postgres:5432/dubbing
# BROKER_URL=redis://redis:6379/0        # or sqs:// or amqp://

# --- Provider credentials -----------------------------------------------------
# Per the brief, model SELECTION lives in config files or env vars (above), while
# credentials come from environment variables or secrets management. They are
# deliberately NOT readable from config/*.yaml (that file is version-controlled).
#
# Each can also be supplied as a mounted secret file named after the lowercased
# variable, e.g. /run/secrets/openai_api_key  (override the dir with SECRETS_DIR).
#
# OPENAI_API_KEY=            # openai_whisper (STT), openai (translation)
# ANTHROPIC_API_KEY=         # claude (translation)
# GEMINI_API_KEY=            # gemini (translation); GOOGLE_API_KEY also accepted
# DEEPGRAM_API_KEY=          # deepgram (STT)
# ASSEMBLYAI_API_KEY=        # assemblyai (STT, includes speaker labels)
# GOOGLE_API_KEY=            # google_stt (STT)
# GOOGLE_CLOUD_PROJECT=      # google_stt (STT)
# DEEPL_API_KEY=             # deepl (translation)
# ELEVENLABS_API_KEY=        # elevenlabs (TTS)
# AZURE_SPEECH_KEY=          # azure (TTS — SSML emotion styles)
# AZURE_SPEECH_REGION=       # azure (TTS), e.g. westeurope
# COQUI_TOS_AGREED=1         # xtts voice cloning (CPML licence acceptance)
# OPENVOICE_CKPT=            # openvoice checkpoint directory
# SECRETS_DIR=/run/secrets   # where mounted secret files are read from
